# Copy to backend/.env and adjust. Lines are optional; sane local defaults apply.

# --- Networking (loopback only — never expose directly) ---
CO_HOST=127.0.0.1
CO_PORT=8777

# --- Database ---
# Dev default: SQLite file. Production: PostgreSQL.
# CO_DATABASE_URL=sqlite:///./var/cyberorch.db
# CO_DATABASE_URL=postgresql+psycopg://cyberorch:CHANGE_ME@127.0.0.1/cyberorch

# --- Access control (production) ---
# Set to require a token on every /api call (header X-API-Token or ?token=).
# Generate one:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# CO_API_TOKEN=

# --- Background scans ---
CO_MAX_CONCURRENT_RUNS=4   # scan thread-pool size (live progress via WebSocket)

# --- Safety switches ---
CO_OFFENSIVE_ENABLED=true     # false disables all offensive modules globally
CO_ENFORCE_SCOPE=true         # keep true in production

# --- Reporting identity ---
CO_REPORT_AUTHOR=Your Name
CO_REPORT_ORG=Your Lab

# --- Update module (optional outbound) ---
# CO_NVD_API_KEY=
