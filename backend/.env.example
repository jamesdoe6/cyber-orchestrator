# Copy to backend/.env and adjust. All optional; sane local defaults apply.
CO_HOST=127.0.0.1
CO_PORT=8777
# Postgres: CO_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1/cyberorch
# CO_DATABASE_URL=sqlite:///./var/cyberorch.db

# Safety switches
CO_OFFENSIVE_ENABLED=true     # set false to globally disable offensive plugins
CO_ENFORCE_SCOPE=true         # keep true in production

# Reporting identity
CO_REPORT_AUTHOR=Your Name
CO_REPORT_ORG=Your Lab

# Update module (optional outbound)
# CO_NVD_API_KEY=xxxxxxxx
